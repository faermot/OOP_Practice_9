<UserControl x:Class="OOP_Practice_9.UserControls.AddButtonUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             x:Name="addButtonUC"
             d:DesignHeight="90" d:DesignWidth="300">

    <Button Width="300" Height="90"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Cursor="Hand"
            Background="White"
            FontSize="16"
            FontWeight="Bold"
            FocusVisualStyle="{x:Null}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="45">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Button.Template>
        <Button.Triggers>
            <EventTrigger RoutedEvent="Button.MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                        To="#E0E0E0" Duration="0:0:0.15"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="Button.MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                        To="#FFFFFF" Duration="0:0:0.15"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Button.Triggers>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding ElementName=addButtonUC, Path=Title}"
                       VerticalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="#2F2C37"/>
            <Border Margin="20 0 0 0" Width="37" Padding="10"
                    Background="#475272" CornerRadius="50">
                <materialDesign:PackIcon Kind="AddBold" Foreground="White" Width="16" Height="16"/>
            </Border>
        </StackPanel>
    </Button>
</UserControl>
